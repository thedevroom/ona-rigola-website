{
  "name": "ona-rigola-website",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web oficial de Ona Rigola, tatuadora independiente en Barcelona.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "assets": "node scripts/prepare-assets.mjs",
    "a11y:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
