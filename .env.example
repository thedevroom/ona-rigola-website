# ---------------------------------------------------------------------------
# Ona Rigola — variables de entorno
# Copia este archivo como `.env.local` y completa los valores reales.
# Ningún secreto debe versionarse en el repositorio.
# ---------------------------------------------------------------------------

# URL pública definitiva del sitio (sin barra final).
# Se usa para metadatos canónicos, sitemap, robots.txt y datos estructurados.
# En producción: https://<dominio-real>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Envío de solicitudes de cita ------------------------------------------
# El formulario funciona de forma real solo si estas tres variables existen.
# Se utiliza Resend (API HTTP, sin SDK). Crea una clave en https://resend.com
CONTACT_PROVIDER=resend
CONTACT_API_KEY=
# Remitente verificado en el proveedor. Ejemplo: "Web Ona Rigola <web@dominio.com>"
CONTACT_FROM_EMAIL=
# Buzón de la artista que recibirá las solicitudes.
CONTACT_TO_EMAIL=
